# Copy to scripts/bench-night.env (git-ignored: it holds the SpacetimeDB token) and fill in the paths on main.
LLAMA_SERVER=/Users/you/llama-b8665/llama-server
COORDINATOR=/Users/you/hacktud_team_win/target/release/coordinator
BENCH=/Users/you/hacktud_team_win/target/release/bench
MODEL_12B=/Users/you/models/gemma-4-12b-it-Q4_K_M.gguf
MODEL_26B=/Users/you/models/gemma-4-26B-A4B-it-Q8_0.gguf
# Optional: pull the 26B from a helper during the single-Mac runs (helper: cd <dir> && python3 -m http.server 8099)
MODEL_26B_URL=http://192.168.8.204:8099/gemma-4-26B-A4B-it-Q8_0.gguf
MODEL_26B_BYTES=26859861728
# The publisher (admin) token; on the Mac that published `pool` it is in the spacetime CLI login:
SPACETIME_TOKEN="$(grep -E '^spacetimedb_token' ~/.config/spacetime/cli.toml | cut -d'"' -f2)"
SPACETIME_URI=http://192.168.8.113:3000
PUBLIC_HOST=192.168.8.113
MAIN_NODE=m3-air-113
HELPER_NODES="m5-air-174 p5-air-204"
MIN_HELPERS=2
RUNS="B1 B1s B2 B2s B3 B4 B5"
